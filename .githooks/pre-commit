#!/bin/sh
project_root=$(git rev-parse --show-toplevel) || exit 1
if [ -x "$project_root/.tools/node-v24.21.0-win-x64/node.exe" ]; then
  node_binary="$project_root/.tools/node-v24.21.0-win-x64/node.exe"
elif command -v node >/dev/null 2>&1; then
  node_binary=node
else
  echo 'Node compatível é obrigatório para validar o histórico.' >&2
  exit 1
fi
front_root="${PINGOFIN_FRONT_ROOT:-$(dirname "$project_root")/pingo-front-crm}"
if [ ! -f "$front_root/scripts/check-external-agent-change.mjs" ]; then
  echo 'Clone o frontend irmão ou configure PINGOFIN_FRONT_ROOT para validar o registro privado.' >&2
  exit 1
fi
exec "$node_binary" "$front_root/scripts/check-external-agent-change.mjs"
