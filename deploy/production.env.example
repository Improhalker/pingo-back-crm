# Copy to .env.production, chmod 600, fill only on the server. Never commit it.
# Use scripts/init-production-env.sh once to generate keys without printing them.
PINGOFIN_IMAGE=pingofin-api:SET_RELEASE_TAG
PINGOFIN_HTTP_PORT=8088
APP_NAME=PingoFin
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://api.pingofin.com.br
APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=en
APP_MAINTENANCE_DRIVER=file
# app.pingofin.com.br is the proposed authenticated frontend, pending confirmation.
FRONTEND_URL=https://app.pingofin.com.br
SANCTUM_STATEFUL_DOMAINS=app.pingofin.com.br,api.pingofin.com.br
SESSION_DOMAIN=.pingofin.com.br
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_COOKIE=pingofin_session
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
# Host Nginx appears from the Docker bridge gateway. Set its actual IP/CIDR.
# Never set * on a publicly reachable container.
TRUSTED_PROXIES=
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=pingofin
DB_USERNAME=pingofin
DB_PASSWORD=
MYSQL_ROOT_PASSWORD=
QUEUE_CONNECTION=redis
QUEUE_FAILED_DRIVER=database-uuids
REDIS_QUEUE_RETRY_AFTER=90
CACHE_STORE=redis
REDIS_CLIENT=predis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_CACHE_DB=1
REDIS_PREFIX=pingofin_production_
LOG_CHANNEL=stderr
LOG_LEVEL=warning
FILESYSTEM_DISK=local
MAIL_MAILER=log
INTERNAL_KANBAN_ENABLED=false
DEV_USER_PASSWORD=
